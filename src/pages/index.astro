---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import RecipeCard from '../components/RecipeCard.astro';

// Get all recipes from the content collection
const recipes = await getCollection('recipes');
---

<BaseLayout>
  <Header />

  <main class="min-h-screen flex items-center justify-center px-4 py-12">
    <!-- Open Book Container -->
    <div class="max-w-7xl w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 shadow-2xl" style="filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));">

        <!-- Left Page - Title -->
        <div class="bg-page p-12 lg:p-16 flex flex-col justify-center border-r-2 border-ink/10 relative">
          <!-- Page edge shadow -->
          <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-black/10 to-transparent pointer-events-none"></div>

          <div class="font-serif">
            <div class="mb-8">
              <div class="text-sm uppercase tracking-widest text-ink-light mb-2">Family Collection</div>
              <h1 class="text-6xl lg:text-7xl font-bold text-ink leading-tight mb-6">
                Jaffe-Ruffer Family<br/>Recipes
              </h1>
              <div class="w-24 h-1 bg-primary mb-8"></div>
            </div>

            <p class="text-lg text-ink-light leading-relaxed mb-8 max-w-md">
              A collection of cherished family recipes passed down through generations or collected from a random website or a cookbook.
            </p>

            <div class="border-t border-b border-ink/20 py-4 inline-block">
              <div class="text-sm uppercase tracking-wider text-ink-light mb-1">Total Recipes</div>
              <div class="text-5xl font-bold text-ink">{recipes.length}</div>
            </div>
          </div>
        </div>

        <!-- Right Page - Table of Contents -->
        <div class="bg-page p-12 lg:p-16 relative">
          <!-- Page edge shadow -->
          <div class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-black/10 to-transparent pointer-events-none"></div>

          <div class="font-serif">
            <h2 class="text-3xl font-bold text-ink mb-8 border-b-2 border-ink/20 pb-4">
              Table of Contents
            </h2>

            {recipes.length > 0 ? (
              <div class="space-y-3 max-h-[600px] overflow-y-auto pr-2">
                {recipes.map((recipe, index) => (
                  <RecipeCard
                    title={recipe.data.title}
                    blurb={recipe.data.blurb}
                    slug={recipe.slug}
                    image={recipe.data.images?.[0]}
                    prepTime={recipe.data.prepTime}
                    servings={recipe.data.servings}
                    difficulty={recipe.data.difficulty}
                    tags={recipe.data.tags}
                    index={index + 1}
                  />
                ))}
              </div>
            ) : (
              <p class="text-ink-light italic">No recipes yet. Start adding your family favorites!</p>
            )}
          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>

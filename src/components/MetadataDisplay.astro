---
interface Props {
  prepTime: string;
  cookTime: string;
  servings: string;
  difficulty?: 'Easy' | 'Medium' | 'Hard';
}

const { prepTime, cookTime, servings, difficulty } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
  <div class="text-center p-4 bg-ink/5 rounded">
    <div class="text-xs uppercase tracking-wider text-ink-light mb-2">Prep Time</div>
    <div class="text-2xl font-bold text-ink">{prepTime}</div>
  </div>

  <div class="text-center p-4 bg-ink/5 rounded">
    <div class="text-xs uppercase tracking-wider text-ink-light mb-2">Cook Time</div>
    <div class="text-2xl font-bold text-ink">{cookTime}</div>
  </div>

  <div class="text-center p-4 bg-ink/5 rounded">
    <div class="text-xs uppercase tracking-wider text-ink-light mb-2">Servings</div>
    <div class="text-2xl font-bold text-ink">{servings}</div>
  </div>

  {difficulty && (
    <div class="text-center p-4 bg-ink/5 rounded">
      <div class="text-xs uppercase tracking-wider text-ink-light mb-2">Difficulty</div>
      <div class="text-base font-bold text-ink uppercase tracking-wide">{difficulty}</div>
    </div>
  )}
</div>

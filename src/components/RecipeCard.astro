---
interface Props {
  title: string;
  blurb: string;
  slug: string;
  image: string;
  prepTime: string;
  servings: number;
  difficulty?: 'Easy' | 'Medium' | 'Hard';
  tags?: string[];
  index?: number;
}

const { title, blurb, slug, image, prepTime, servings, difficulty, tags, index } = Astro.props;
const displayTags = tags?.slice(0, 3) || [];
---

<a
  href={`/recipes/${slug}`}
  class="block group bg-card hover:bg-card-hover border border-card rounded-lg p-6 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1"
>
  <!-- Title Row -->
  <div class="flex items-baseline gap-3 mb-3">
    {index && (
      <span class="text-ink-light font-mono text-sm flex-shrink-0">{index.toString().padStart(2, '0')}</span>
    )}
    <h3 class="text-xl font-semibold text-ink group-hover:text-primary transition-colors">
      {title}
    </h3>
  </div>

  <!-- Blurb -->
  <p class="text-[1.1rem] text-ink-light mb-4 leading-relaxed">{blurb}</p>

  <!-- Tags Row -->
  {displayTags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {displayTags.map((tag) => (
        <span class="text-xs uppercase tracking-wider px-2 py-0.5 bg-ink/10 text-ink-light rounded capitalize whitespace-nowrap inline-block">{tag}</span>
      ))}
    </div>
  )}
</a>

---
interface Props {
  title: string;
  blurb: string;
  slug: string;
  image: string;
  prepTime: string;
  servings: number;
  difficulty?: 'Easy' | 'Medium' | 'Hard';
  tags?: string[];
  index?: number;
}

const { title, blurb, slug, image, prepTime, servings, difficulty, tags, index } = Astro.props;
const displayTags = tags?.slice(0, 3) || [];
---

<a
  href={`/recipes/${slug}`}
  class="block group py-3 px-4 hover:bg-ink/5 rounded transition-colors border-b border-ink/10"
>
  <div class="flex items-start justify-between gap-3 sm:gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-baseline gap-3">
        {index && (
          <span class="text-ink-light font-mono text-sm flex-shrink-0">{index.toString().padStart(2, '0')}</span>
        )}
        <h3 class="text-lg font-semibold text-ink group-hover:text-primary transition-colors">
          {title}
        </h3>
      </div>
      <p class="text-[1.1rem] text-ink-light mt-1 ml-8">{blurb}</p>
    </div>
    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-1 sm:gap-2 flex-shrink-0 sm:justify-end items-end sm:items-start w-auto sm:w-1/3">
      {displayTags.map((tag) => (
        <span class="text-xs uppercase tracking-wider px-2 py-0.5 bg-ink/10 text-ink-light rounded capitalize whitespace-nowrap inline-block">{tag}</span>
      ))}
    </div>
  </div>
</a>

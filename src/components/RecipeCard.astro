---
interface Props {
  title: string;
  blurb: string;
  slug: string;
  image: string;
  prepTime: string;
  servings: number;
  difficulty?: 'Easy' | 'Medium' | 'Hard';
  index?: number;
}

const { title, blurb, slug, image, prepTime, servings, difficulty, index } = Astro.props;
---

<a
  href={`/recipes/${slug}`}
  class="block group py-3 px-4 hover:bg-ink/5 rounded transition-colors border-b border-ink/10"
>
  <div class="flex items-baseline justify-between gap-4">
    <div class="flex-1">
      <div class="flex items-baseline gap-3">
        {index && (
          <span class="text-ink-light font-mono text-sm flex-shrink-0">{index.toString().padStart(2, '0')}</span>
        )}
        <h3 class="text-lg font-semibold text-ink group-hover:text-primary transition-colors">
          {title}
        </h3>
      </div>
      <p class="text-sm text-ink-light mt-1 ml-8">{blurb}</p>
    </div>
    <div class="flex items-center gap-3 text-xs text-ink-light flex-shrink-0">
      <span>{prepTime}</span>
      <span class="text-ink/30">•</span>
      <span>{servings} servings</span>
    </div>
  </div>
</a>

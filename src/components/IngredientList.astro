---
interface Props {
  ingredients: string[];
}

const { ingredients } = Astro.props;
---

<div class="border-2 border-ink/10 rounded p-6 bg-ink/5">
  <h2 class="text-2xl font-bold text-ink mb-6 border-b border-ink/20 pb-3">Ingredients</h2>
  <ul class="space-y-3">
    {ingredients.map((ingredient) => (
      <li class="flex items-start gap-3 text-ink">
        <span class="text-ink-light mt-1">•</span>
        <span class="text-[1.1rem] leading-relaxed">{ingredient}</span>
      </li>
    ))}
  </ul>
</div>
